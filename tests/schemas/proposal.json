            "set_encoder": "#/$defs/SetEncoderOperation",
            "set_key": "#/$defs/SetKeyOperation",
            "set_key_override": "#/$defs/SetKeyOverrideOperation",
            "set_layout_options": "#/$defs/SetLayoutOptionsOperation",
            "set_tap_dance": "#/$defs/SetTapDanceOperation"
