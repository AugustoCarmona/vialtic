          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/SetKeyOperation"
          },
          {
            "$ref": "#/$defs/SetEncoderOperation"
          },
          {
            "$ref": "#/$defs/SetLayoutOptionsOperation"
          },
          {
            "$ref": "#/$defs/SetTapDanceOperation"
          },
          {
            "$ref": "#/$defs/SetComboOperation"
          },
          {
            "$ref": "#/$defs/SetKeyOverrideOperation"
