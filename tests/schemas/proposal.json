          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "serial_number": {
          "title": "Serial Number",
          "type": "string"
        },
        "simulated": {
          "default": false,
          "title": "Simulated",
          "type": "boolean"
