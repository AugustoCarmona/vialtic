{
  "$defs": {
    "DeviceIdentity": {
      "additionalProperties": false,
      "description": "How a keyboard was recognized. `device_id` only selects it for this plug session.",
      "properties": {
        "binding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binding Id"
        },
        "device_id": {
          "title": "Device Id",
          "type": "string"
        },
        "identity_confidence": {
          "default": "unknown",
          "enum": [
            "usb_serial",
            "model_and_firmware",
            "unknown"
          ],
          "title": "Identity Confidence",
          "type": "string"
        },
        "identity_note": {
          "default": "",
          "title": "Identity Note",
          "type": "string"
        },
        "layout_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layout Fingerprint"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "serial_number": {
          "title": "Serial Number",
          "type": "string"
        },
        "simulated": {
          "default": false,
          "title": "Simulated",
          "type": "boolean"
        },
        "vendor_id": {
          "title": "Vendor Id",
          "type": "string"
        },
        "via_protocol": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Via Protocol"
        },
        "vial_protocol": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vial Protocol"
        },
        "vial_uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vial Uid"
        }
      },
      "required": [
        "device_id",
        "name",
        "vendor_id",
        "product_id",
        "serial_number",
        "path"
      ],
      "title": "DeviceIdentity",
      "type": "object"
    },
    "KeycodeInfo": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "keycode": {
          "title": "Keycode",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "masked": {
          "default": false,
          "title": "Masked",
          "type": "boolean"
        }
      },
      "required": [
        "keycode",
        "label"
      ],
      "title": "KeycodeInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "device": {
      "$ref": "#/$defs/DeviceIdentity"
    },
    "keycodes": {
      "items": {
        "$ref": "#/$defs/KeycodeInfo"
      },
      "title": "Keycodes",
      "type": "array"
    },
    "kind": {
      "const": "keycode_list",
      "default": "keycode_list",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "device",
    "keycodes"
  ],
  "title": "KeycodeList",
  "type": "object"
}
