        "index": {
          "title": "Index",
          "type": "integer"
        },
        "keys": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keys"
        },
        "output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
