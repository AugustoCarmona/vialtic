    "SetKeyOverrideChange": {
      "additionalProperties": false,
      "description": "Change one key override. Fields left out keep their current value. Masks are integers:\n`layers` has one bit per layer, modifier masks follow QMK's MOD_BIT layout, and `options`\nholds the firmware flags, with bit 7 enabling the entry.",
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "layers": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
