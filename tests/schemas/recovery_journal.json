{
  "$defs": {
    "DeviceIdentity": {
      "additionalProperties": false,
      "description": "How a keyboard was recognized. `device_id` only selects it for this plug session.",
      "properties": {
        "binding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binding Id"
        },
        "device_id": {
          "title": "Device Id",
          "type": "string"
        },
        "identity_confidence": {
          "default": "unknown",
          "enum": [
            "usb_serial",
            "model_and_firmware",
            "unknown"
          ],
          "title": "Identity Confidence",
          "type": "string"
        },
        "identity_note": {
          "default": "",
          "title": "Identity Note",
          "type": "string"
        },
        "layout_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layout Fingerprint"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "serial_number": {
          "title": "Serial Number",
          "type": "string"
        },
        "simulated": {
          "default": false,
          "title": "Simulated",
          "type": "boolean"
        },
        "vendor_id": {
          "title": "Vendor Id",
          "type": "string"
        },
        "via_protocol": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Via Protocol"
        },
        "vial_protocol": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vial Protocol"
        },
        "vial_uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vial Uid"
        }
      },
      "required": [
        "device_id",
        "name",
        "vendor_id",
        "product_id",
        "serial_number",
        "path"
      ],
      "title": "DeviceIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Interrupted-write metadata. Never a configuration history; holds no key data.",
  "properties": {
    "binding_id": {
      "title": "Binding Id",
      "type": "string"
    },
    "completed_operations": {
      "title": "Completed Operations",
      "type": "integer"
    },
    "device": {
      "$ref": "#/$defs/DeviceIdentity"
    },
    "kind": {
      "const": "recovery_journal",
      "default": "recovery_journal",
      "title": "Kind",
      "type": "string"
    },
    "lighting_save_sent": {
      "default": false,
      "title": "Lighting Save Sent",
      "type": "boolean"
    },
    "note": {
      "default": "",
      "title": "Note",
      "type": "string"
    },
    "proposal_id": {
      "title": "Proposal Id",
      "type": "string"
    },
    "proposal_type": {
      "enum": [
        "change",
        "undo",
        "recovery"
      ],
      "title": "Proposal Type",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "applying",
        "needs_recovery",
        "verified"
      ],
      "title": "Status",
      "type": "string"
    },
    "total_operations": {
      "title": "Total Operations",
      "type": "integer"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "proposal_id",
    "proposal_type",
    "binding_id",
    "device",
    "status",
    "total_operations",
    "completed_operations",
    "started_at",
    "updated_at"
  ],
  "title": "Journal",
  "type": "object"
}
