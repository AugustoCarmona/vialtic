{
  "$defs": {
    "DeviceIdentity": {
      "additionalProperties": false,
      "description": "How a keyboard was recognized. `device_id` only selects it for this plug session.",
      "properties": {
        "binding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binding Id"
        },
        "device_id": {
          "title": "Device Id",
          "type": "string"
        },
        "identity_confidence": {
          "default": "unknown",
          "enum": [
            "usb_serial",
            "model_and_firmware",
            "unknown"
          ],
          "title": "Identity Confidence",
          "type": "string"
        },
        "identity_note": {
          "default": "",
          "title": "Identity Note",
          "type": "string"
        },
        "layout_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layout Fingerprint"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "serial_number": {
          "title": "Serial Number",
          "type": "string"
        },
        "simulated": {
          "default": false,
          "title": "Simulated",
          "type": "boolean"
        },
        "vendor_id": {
          "title": "Vendor Id",
          "type": "string"
        },
        "via_protocol": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Via Protocol"
        },
        "vial_protocol": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vial Protocol"
        },
        "vial_uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vial Uid"
        }
      },
      "required": [
        "device_id",
        "name",
        "vendor_id",
        "product_id",
        "serial_number",
        "path"
      ],
      "title": "DeviceIdentity",
      "type": "object"
    },
    "OperationResult": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "status": {
          "enum": [
            "applied",
            "not_attempted",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "index",
        "summary",
        "status"
      ],
      "title": "OperationResult",
      "type": "object"
    },
    "VerificationDifference": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "default": null,
          "title": "Expected"
        },
        "family": {
          "title": "Family",
          "type": "string"
        },
        "observed": {
          "default": null,
          "title": "Observed"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "family",
        "target"
      ],
      "title": "VerificationDifference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "backup_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Backup Path"
    },
    "binding_id": {
      "title": "Binding Id",
      "type": "string"
    },
    "device": {
      "$ref": "#/$defs/DeviceIdentity"
    },
    "differences": {
      "items": {
        "$ref": "#/$defs/VerificationDifference"
      },
      "title": "Differences",
      "type": "array"
    },
    "kind": {
      "const": "apply_result",
      "default": "apply_result",
      "title": "Kind",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/OperationResult"
      },
      "title": "Operations",
      "type": "array"
    },
    "outcome": {
      "enum": [
        "verified",
        "failed_restored",
        "partial",
        "unknown"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "proposal_id": {
      "title": "Proposal Id",
      "type": "string"
    },
    "recovery_steps": {
      "items": {
        "type": "string"
      },
      "title": "Recovery Steps",
      "type": "array"
    },
    "relock_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relock Error"
    },
    "relocked": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relocked"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "write_packets_sent": {
      "default": 0,
      "title": "Write Packets Sent",
      "type": "integer"
    }
  },
  "required": [
    "proposal_id",
    "binding_id",
    "device",
    "outcome",
    "message",
    "operations"
  ],
  "title": "ApplyResult",
  "type": "object"
}
